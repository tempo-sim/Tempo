{
	"FileVersion": 3,
	"Version": 1,
	"VersionName": "1.0",
	"FriendlyName": "TempoAgents",
	"Description": "Tempo plugin for simulating agent behaviors",
	"Category": "Tempo",
	"CreatedBy": "Tempo Simulation, LLC",
	"CreatedByURL": "https://temposimulation.com",
	"DocsURL": "",
	"MarketplaceURL": "",
	"CanContainContent": true,
	"IsBetaVersion": false,
	"IsExperimentalVersion": false,
	"Installed": false,
	"Modules": [
		{
			"Name": "TempoAgentsEditor",
			"Type": "Editor",
			"LoadingPhase": "Default"
		},
		{
			"Name": "TempoAgents",
			"Type": "Runtime",
			"LoadingPhase": "Default"
		}
	],
	"Plugins": [
		{
			"Name": "Traffic",
			"Enabled": true
		},
		{
			"Name": "TempoCore",
			"Enabled": true
		}
	],
	"PreBuildSteps": {
		"Win64": [
			"\"$(EngineDir)\\Binaries\\ThirdParty\\Python3\\Win64\\python.exe\" \"$(PluginDir)\\Content\\Python\\gen_engine_derived.py\" \"$(EngineDir)\" \"$(PluginDir)\""
		],
		"Mac": [
			"\"$(EngineDir)/Binaries/ThirdParty/Python3/Mac/bin/python3\" \"$(PluginDir)/Content/Python/gen_engine_derived.py\" \"$(EngineDir)\" \"$(PluginDir)\""
		],
		"Linux": [
			"\"$(EngineDir)/Binaries/ThirdParty/Python3/Linux/bin/python3\" \"$(PluginDir)/Content/Python/gen_engine_derived.py\" \"$(EngineDir)\" \"$(PluginDir)\""
		]
	}
}
