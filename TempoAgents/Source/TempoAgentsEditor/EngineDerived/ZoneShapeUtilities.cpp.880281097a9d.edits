struct FLaneConnectionSlot
{
	FVector Position = FVector::ZeroVector;
	FVector Forward = FVector::ZeroVector;
	FVector Up = FVector::ZeroVector;
	FZoneLaneDesc LaneDesc;
	int32 PointIndex = 0;	// Index in dest point array
	int32 Index = 0;		// Index within an entry
	uint16 EntryID = 0;		// Entry ID from source data
	const FZoneLaneProfile* Profile = nullptr;
	EZoneShapeLaneConnectionRestrictions Restrictions = EZoneShapeLaneConnectionRestrictions::None;
	float DistanceFromProfileEdge = 0.0f;	// Distance from lane profile edge
	float DistanceFromFarProfileEdge = 0.0f; // Distance to other lane profile edge
	float InnerTurningRadius = 0.0f; // Inner/minimum turning radius when using Arc routing.
};

using FLaneConnectionCandidate = FTempoLaneConnectionCandidate;

static TArray<FTempoLaneConnectionInfo> MakeLaneConnectionInfos(TConstArrayView<FLaneConnectionSlot> Slots)
{
	TArray<FTempoLaneConnectionInfo> LaneConnectionInfos;
	LaneConnectionInfos.Reserve(Slots.Num());
	for (const FLaneConnectionSlot& Slot : Slots)
	{
		FTempoLaneConnectionInfo& LaneConnectionInfo = LaneConnectionInfos.AddDefaulted_GetRef();
		LaneConnectionInfo.Position = Slot.Position;
		LaneConnectionInfo.Forward = Slot.Forward;
		LaneConnectionInfo.Up = Slot.Up;
		LaneConnectionInfo.LaneDesc = Slot.LaneDesc;
		LaneConnectionInfo.Restrictions = Slot.Restrictions;
		LaneConnectionInfo.LaneIndex = Slot.Index;
	}
	return LaneConnectionInfos;
}

