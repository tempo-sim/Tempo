# Visual Studio 2015 user specific files
.vs/
.vsconfig

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# Precompiled Assets
SourceArt/**/*.png
SourceArt/**/*.tga

# Binary Files
**/Binaries/*

# Builds
**/Build/*

# Configuration files generated by the Editor
Saved/*

# Compiled source files for the engine to use
**/Intermediate/*

.DS_Store
.idea

# Test harness scratch (venv for TestPython.sh; vendored crate + build output for TestRust.sh)
.tempo_test_venv/
Tests/Rust/vendor/
Tests/Rust/target/

# Generated proto files
*.pb.*
*_pb2*.py

# pycache folders
__pycache__

# Tempo Prebuild Cache
.tempo_prebuild_cache.json

# MkDocs local builds (docs are built by Read the Docs; see .readthedocs.yaml)
site/
.venv/

# TempoROS is a separate repository, added to the host project's Plugins folder rather than vendored
# here. A checkout that predates that change still has the old submodule's working tree sitting at
# Tempo/TempoROS, untracked. Ignoring it keeps `git add -A` from committing it back as an embedded
# git repository, and keeps `git clean -fd` from deleting someone's rclcpp download.
/TempoROS/

# Generated at build time from the engine source; see TempoAgentsEditor/EngineDerived
TempoAgents/Source/TempoAgentsEditor/Private/EngineDerived/
