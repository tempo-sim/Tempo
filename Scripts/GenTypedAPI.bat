@echo off
setlocal enabledelayedexpansion

REM Generates the typed class surface for this build: runs the schema commandlet in the editor,
REM then turns the one schema into a Python package and (when Rust generation is opted in) a Rust
REM crate.
REM
REM Called by Package.bat before the clients are built. Can be run on its own to refresh the
REM classes after changing a Blueprint or a UPROPERTY:
REM
REM   Scripts\GenTypedAPI.bat
REM
REM The schema lands in Saved\TempoSchema\tempo_schema.json, the Python package in
REM Saved\TempoTypedAPI\python\<dist>\ and the Rust crate in Saved\TempoTypedAPI\rust\<crate>\.
REM
REM Rust follows the same gate as the RPC client generator, TEMPO_GEN_RUST_API.

set "SCRIPT_DIR=%~dp0"

for /f "usebackq delims=" %%I in (`"%SCRIPT_DIR%FindProjectRoot.bat"`) do set "PROJECT_ROOT=%%I"
if not defined PROJECT_ROOT exit /b 1

set "PROJECT_NAME="
for %%F in ("!PROJECT_ROOT!\*.uproject") do (
    if exist "%%F" set "PROJECT_NAME=%%~nF"
)
if not defined PROJECT_NAME (
    echo No .uproject file found 1>&2
    exit /b 1
)

for /f "usebackq delims=" %%I in (`"%SCRIPT_DIR%FindUnreal.bat"`) do set "UNREAL_ENGINE_PATH=%%I"
if not defined UNREAL_ENGINE_PATH exit /b 1

set "PYTHON_DIR=!SCRIPT_DIR!..\TempoCore\Content\Python"

REM Prefer Tempo's managed venv, as Package.bat does; gen_naming.py is stdlib-only so any
REM interpreter can derive the names.
set "PYTHON_BIN="
if exist "!PROJECT_ROOT!\TempoEnv\Scripts\python.exe" set "PYTHON_BIN=!PROJECT_ROOT!\TempoEnv\Scripts\python.exe"
if not defined PYTHON_BIN (
    where python >nul 2>&1 && set "PYTHON_BIN=python"
)
if not defined PYTHON_BIN (
    echo No python interpreter available to generate the typed classes 1>&2
    exit /b 1
)

REM Distribution and import names from gen_naming.py -- the same function that names the project's
REM own generated client -- rather than spelled a second time here.
for /f "usebackq delims=" %%I in (`"!PYTHON_BIN!" -c "import sys; sys.path.insert(0, r'!PYTHON_DIR!'); from gen_naming import project_package_name; print(project_package_name(r'!PROJECT_ROOT!') + '-classes')"`) do set "DIST_NAME=%%I"
for /f "usebackq delims=" %%I in (`"!PYTHON_BIN!" -c "import sys; sys.path.insert(0, r'!PYTHON_DIR!'); from gen_naming import package_import_name; print(package_import_name('!DIST_NAME!'))"`) do set "IMPORT_NAME=%%I"

set "SCHEMA_DIR=!PROJECT_ROOT!\Saved\TempoSchema"
set "SCHEMA=!SCHEMA_DIR!\tempo_schema.json"
set "LOG=!SCHEMA_DIR!\gen_typed_api.log"
if not exist "!SCHEMA_DIR!" mkdir "!SCHEMA_DIR!"

echo Walking reflection to !SCHEMA! (this loads every Blueprint, so it takes a minute)
REM The editor's own exit status is not relied on here: the commandlet's result is what matters, and
REM it says so in the log.
"!UNREAL_ENGINE_PATH!\Engine\Binaries\Win64\UnrealEditor-Cmd.exe" "!PROJECT_ROOT!\!PROJECT_NAME!.uproject" -run=TempoWorldSchema -Out="!SCHEMA!" -nullrhi -unattended -nopause -nosplash -nosound -stdout -fullstdoutlogoutput > "!LOG!" 2>&1

findstr /c:"finished execution (result 0)" "!LOG!" >nul
if errorlevel 1 (
    echo Schema commandlet failed. See !LOG! 1>&2
    exit /b 1
)
if not exist "!SCHEMA!" (
    echo Schema commandlet reported success but wrote nothing to !SCHEMA! 1>&2
    exit /b 1
)
findstr /c:"Wrote schema" "!LOG!"

set "STAGE=!PROJECT_ROOT!\Saved\TempoTypedAPI\python\!DIST_NAME!"
if exist "!STAGE!" rmdir /s /q "!STAGE!"
mkdir "!STAGE!"

echo Generating !IMPORT_NAME!
"!PYTHON_BIN!" "!PYTHON_DIR!\gen_py_classes.py" "!SCHEMA!" "!STAGE!\!IMPORT_NAME!"
if errorlevel 1 exit /b 1

REM The version follows tempo-sim's, so a client and the classes it addresses move together.
for /f "usebackq tokens=2 delims== " %%V in (`findstr /b /c:"version" "!PYTHON_DIR!\API\pyproject.toml"`) do set "TEMPO_SIM_VERSION=%%~V"

> "!STAGE!\pyproject.toml" (
    echo # Generated by Scripts\GenTypedAPI.bat. Do not edit.
    echo [build-system]
    echo requires = ["setuptools^>=77.0"]
    echo build-backend = "setuptools.build_meta"
    echo.
    echo [project]
    echo name = "!DIST_NAME!"
    echo version = "!TEMPO_SIM_VERSION!"
    echo description = "Typed Python classes for this build of !PROJECT_NAME!, generated from its Unreal reflection."
    echo requires-python = "^>=3.9"
    echo license = "Apache-2.0"
    echo dependencies = ["tempo-sim==!TEMPO_SIM_VERSION!"]
    echo.
    echo [tool.setuptools.packages.find]
    echo include = ["!IMPORT_NAME!", "!IMPORT_NAME!.*"]
    echo.
    echo # The .pyi files are the whole point and are not .py, so they are listed explicitly -- as is
    echo # py.typed, without which a type checker ignores an installed package's stubs altogether.
    echo [tool.setuptools.package-data]
    echo "*" = ["py.typed", "*.pyi", "*.meta.json", "index.json", "hashes.json", "schema_header.json"]
)

echo Typed Python classes staged at !STAGE!

REM No published class subset here, deliberately.
REM
REM The subset describes the modules every build ships, so it can travel with the published wheel
REM (TYPED_WORLD_API_PLAN.md section 16) -- but only if what it narrows is itself narrowed to a
REM packaged build. This mirror generates from the editor's unfiltered walk, which has ~46%% more
REM classes than a packaged game and editor-only members on the classes both have. A published
REM package built from that would describe classes and members no build has, which is worse than
REM having none. Said out loud rather than skipped silently, because the .sh has the same guard and
REM takes it when there is no packaged build either.
echo Skipping the published classes ^(this mirror generates from the editor's unfiltered walk^)

REM The Rust crate, from the same schema. Its version follows tempo-sim's crate version so that a
REM client and the classes it addresses move together.
if not defined TEMPO_GEN_RUST_API goto :no_rust
if "!TEMPO_GEN_RUST_API!"=="0" goto :no_rust

set "RUST_STAGE=!PROJECT_ROOT!\Saved\TempoTypedAPI\rust\!DIST_NAME!"
for /f "usebackq tokens=2 delims== " %%V in (`findstr /b /c:"version" "!SCRIPT_DIR!..\TempoCore\Content\Rust\API\Cargo.toml"`) do set "TEMPO_SIM_CRATE_VERSION=%%~V"
if exist "!RUST_STAGE!" rmdir /s /q "!RUST_STAGE!"
mkdir "!RUST_STAGE!"
echo Generating !DIST_NAME! ^(Rust^)
"!PYTHON_BIN!" "!PYTHON_DIR!\gen_rust_classes.py" "!SCHEMA!" "!RUST_STAGE!" "--version=!TEMPO_SIM_CRATE_VERSION!"
if errorlevel 1 exit /b 1
echo Typed Rust classes staged at !RUST_STAGE!
exit /b 0

:no_rust
echo Skipping the typed Rust classes (set TEMPO_GEN_RUST_API=1 to generate them)
exit /b 0
