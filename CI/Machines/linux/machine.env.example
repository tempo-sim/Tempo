# Tempo CI machine contract (see .github/workflows/build_and_package_native.yml in Tempo). Sourced by bash
# at the start of every native job, and by the machine scripts in CI/Machines.
TEMPO_CI_MACHINE_NAME=tempo-linux-ci
# An XFS filesystem with reflinks (linux/bootstrap.sh makes one in an image file when the disk has none),
# so a job's build tree is an instant copy-on-write clone of the golden one.
TEMPO_CI_ROOT=/ci
TEMPO_CI_MIN_FREE_GB=100
# Run by a job's Check Machine step with the reason, when the machine needs attention.
TEMPO_CI_ALERT_COMMAND=/home/ci/tempo-ci/bin/notify.sh

# One engine per supported Unreal version (Epic's Linux binary build, unzipped; it brings its own clang).
# The ci user needs to read it, and nothing more - but it must be able to LIST every directory above it,
# not only pass through: Unreal resolves a path whose case is wrong by reading each directory from / down.
# So not in a home directory. Each version also needs its own runner, labelled tempo-ue-<version>
# (register-runner.sh).
TEMPO_CI_UE_5_7_ENGINE=/opt/UnrealEngine/UE_5.7
TEMPO_CI_UE_5_8_ENGINE=/opt/UnrealEngine/UE_5.8

# Optional: arguments for every sim the tests launch, for this machine's GPU (bootstrap.sh puts them in each
# runner's .env as TEMPO_SIM_EXTRA_ARGS). The first machine's Radeon 780M, under Mesa 26.0's RADV, aborts
# precaching one of Unreal 5.8's compute shaders ("ACO ERROR ... Unimplemented intrinsic instr:
# @store_deref"), a driver bug; nothing the tests render needs that shader. Remove it once Mesa is fixed.
TEMPO_CI_SIM_EXTRA_ARGS="-dpcvars=r.PSOPrecaching=0"
