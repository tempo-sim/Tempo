# Tempo CI machine contract (see .github/workflows/build_and_package_native.yml in Tempo). Sourced by bash
# at the start of every native job, and by the machine scripts in CI/Machines.
TEMPO_CI_MACHINE_NAME=tempo-linux-ci
# An XFS filesystem with reflinks (linux/bootstrap.sh makes one in an image file when the disk has none),
# so a job's build tree is an instant copy-on-write clone of the golden one.
TEMPO_CI_ROOT=/ci
TEMPO_CI_MIN_FREE_GB=100
# Run by a job's Check Machine step with the reason, when the machine needs attention.
TEMPO_CI_ALERT_COMMAND=/home/ci/tempo-ci/bin/notify.sh

# One engine per supported Unreal version (Epic's Linux binary build, unzipped; it brings its own clang).
# The ci user needs to read it, and nothing more. Each version also needs its own runner, labelled
# tempo-ue-<version> (register-runner.sh).
TEMPO_CI_UE_5_7_ENGINE=/home/pete/UE_5.7
TEMPO_CI_UE_5_8_ENGINE=/home/pete/UE_5.8
