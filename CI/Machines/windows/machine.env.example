# Tempo CI machine contract (see .github/workflows/build_and_package_native.yml in Tempo). Sourced by bash
# (Git Bash) at the start of every native job, and by the machine scripts in CI/Machines. Paths are in Git
# Bash's form.
TEMPO_CI_MACHINE_NAME=tempo-windows-ci
# Short on purpose: Unreal's intermediate paths under <root>/<owner>_<repo>/<version>/build/... get long.
TEMPO_CI_ROOT=/c/ci
TEMPO_CI_MIN_FREE_GB=100
# Run by a job's Check Machine step with the reason, when the machine needs attention.
TEMPO_CI_ALERT_COMMAND=/c/Users/ci/tempo-ci/bin/notify.sh

# One engine per supported Unreal version. Each version also needs its own runner, labelled
# tempo-ue-<version> (register-runner.ps1). Both build with Visual Studio 2022 17.14 (MSVC 14.44), the one
# toolchain both engines accept (Engine/Config/Windows/Windows_SDK.json).
TEMPO_CI_UE_5_7_ENGINE="/c/Program Files/Epic Games/UE_5.7"
TEMPO_CI_UE_5_8_ENGINE="/c/Program Files/Epic Games/UE_5.8"
