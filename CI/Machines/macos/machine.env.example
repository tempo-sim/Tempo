# Tempo CI machine contract (see .github/workflows/build_and_package_native.yml in Tempo). Sourced by bash
# at the start of every native job, and by the machine scripts in CI/Machines.
TEMPO_CI_MACHINE_NAME=tempo-mac-ci
TEMPO_CI_ROOT=/Users/ci/tempo-ci/trees
TEMPO_CI_MIN_FREE_GB=100
# Run by a job's Check Machine step with the reason, when the machine needs attention.
TEMPO_CI_ALERT_COMMAND=/Users/ci/tempo-ci/bin/notify.sh

# One engine (and on Mac, one Xcode) per supported Unreal version. Each version also needs its own
# runner, labelled tempo-ue-<version> (register-runner.sh).
TEMPO_CI_UE_5_7_ENGINE="/Users/Shared/Epic Games/UE_5.7"
# UE 5.7 supports Xcode <= 26.9 (Engine/Config/Apple/Apple_SDK.json).
TEMPO_CI_UE_5_7_DEVELOPER_DIR=/Applications/Xcode-26.6.0.app/Contents/Developer

TEMPO_CI_UE_5_8_ENGINE="/Users/Shared/Epic Games/UE_5.8"
TEMPO_CI_UE_5_8_DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer
