"""Types for the connection entry points, which are dual-mode and cannot say so in Python.

`set_server` and `set_socket` are defined twice -- once synchronous, then again as a coroutine
decorated with curio's `@awaitable`, which dispatches on how it was called. The second definition is
the one bound to the name, so without this a checker sees only the coroutine and reports the
synchronous call every script opens with as an unawaited coroutine.

There is no way to spell "returns a value, or a coroutine, depending on the caller", so these say
`Any`: both `set_server(...)` and `await set_server(...)` are then correct, which is the truth.
"""

import contextlib
from typing import Any

DEFAULT_ADDRESS: str
DEFAULT_PORT: int
DEFAULT_SOCKET_NAME: str

def run_async(coroutine: Any) -> Any: ...
def default_socket_directory() -> str: ...
def socket_target(path: str = ...) -> str: ...
def set_server(address: str = ..., port: int = ...) -> Any: ...
def set_socket(path: str = ...) -> Any: ...
def set_request_timeout(seconds: float | None = ...) -> None: ...
def request_timeout() -> float | None: ...
def with_request_timeout(seconds: float | None) -> contextlib.AbstractContextManager[None]: ...

class TempoContext:
    async def get_stub(self, stub_class: Any) -> Any: ...
    async def set_server(self, address: str = ..., port: int = ...) -> None: ...
    async def set_socket(self, path: str = ...) -> None: ...
    @property
    def target(self) -> str: ...

def tempo_context() -> TempoContext: ...
